VehicleFactory.java
package FactoryDP;

public class VehicleFactory {
    Vehicle obj;
    public Vehicle getInstance(String type) {
        if(type.equals("bike")) {
            obj = new Bike();
        } else if(type.equals("car")) {
            obj = new Car();
        } else if(type.equals("truck")) {
            obj = new Truck();
        }
        return obj;
    }
}

Main.java
package org.example;

import FactoryDP.Vehicle;
import FactoryDP.VehicleFactory;

public class Main {
    public static void main(String[] args) {
        VehicleFactory v = new VehicleFactory();

        Vehicle instance = v.getInstance("car");
        Vehicle instance2 = v.getInstance("bike");

        System.out.println(instance.getType());

        System.out.println(instance2.getNoOfWheels());

    }
}
