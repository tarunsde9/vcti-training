package FactoryDP;

public interface Vehicle {

    String getType();
    int getNoOfWheels();
    int getCapacity();

}

Bike.java
package FactoryDP;

public class Bike implements Vehicle {
    @Override
    public String getType() {
        return "This is a bike.";
    }
    public int getNoOfWheels() {
        return 2;
    }
    public int getCapacity() {
        return 2;
    }
}

