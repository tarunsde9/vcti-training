    @Override
    public void save() {
        System.out.println("Save file by JSON: " + this.fn);
    }
}

package Template;

public class Main {
    public static void main(String[] args) {
        DataProcessor csv = new CSV();
        csv.process("file1");

        DataProcessor json = new JSON();
        json.process("file3");
    }
}
