package Observer;

public class Main {
    static void main(String[] args) {
        WeatherStation ws = new WeatherStation();

        StatisticsDisplay sd = new StatisticsDisplay();
        CurrentConditionsDisplay ccd = new CurrentConditionsDisplay();
        ForecastDisplay fd = new ForecastDisplay();

        ws.register(sd);
        ws.register(ccd);
        ws.register(fd);

        ws.setHumidity(22);
        ws.setTemperature(30);

        ws.deRegister(ccd);

        ws.setTemperature(32);
    }
}
package Observer;

public class StatisticsDisplay implements Observer {
    int temperature;
    int humidity;

    @Override
    public void update(int temperature, int humidity) {
        this.temperature = temperature;
        this.humidity = humidity;

        System.out.println("Statistics Display Updated: ");
        System.out.println("Temperature : " + temperature);
        System.out.println("Humidity : " + humidity);
        System.out.println();
    }
}
