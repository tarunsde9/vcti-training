package com.example.course_student_jpa;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

@SpringBootApplication
public class CourseStudentJpaApplication {

	public static void main(String[] args) {
		SpringApplication.run(CourseStudentJpaApplication.class, args);
	}

}
package com.example.course_student_jpa.controller;

import com.example.course_student_jpa.entity.Course;
import com.example.course_student_jpa.service.CourseService;
import org.springframework.web.bind.annotation.*;

import java.time.LocalDateTime;
import java.util.List;

@RestController
@RequestMapping("/courses")
public class CourseController {

    private final CourseService service;

    public CourseController(CourseService service) {
        this.service = service;
    }

    @PostMapping
    public Course create(@RequestBody Course course) {
        return service.save(course);
    }

    @GetMapping
    public List<Course> getAll() {
        return service.getAll();
    }

    @GetMapping("/{id}")
    public Course getById(@PathVariable Long id) {
        return service.getById(id);
    }

    @DeleteMapping("/{id}")
    public void delete(@PathVariable Long id) {
        service.delete(id);
    }

    @GetMapping("/search/name")
    public List<Course> searchByName(@RequestParam String name) {
        return service.searchByName(name);
    }

    @GetMapping("/search/status")
    public List<Course> searchByStatus(@RequestParam String status) {
        return service.searchByStatus(status);
    }

    @GetMapping("/search/date")
    public List<Course> searchByDate(
            @RequestParam LocalDateTime start,
            @RequestParam LocalDateTime end) {
        return service.searchByDate(start, end);
    }
}
