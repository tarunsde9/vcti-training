public class Q5 {
    public static void main(String[] args) {
        Q5 q5 = new Q5();
        try {
            q5.implementation();
        } catch (CustomException1 e) {
            System.out.println("Custom Exception: " + e.getMessage());
            System.out.println("Root Exception: " + e.getCause());
        }

    }

    void implementation() throws CustomException1 {
        try {
            int result = (10/0);
        } catch (ArithmeticException e) {
            throw new CustomException1("this is root cause", e);
        }
    }
}

class CustomException1 extends Exception {
    public CustomException1(String message, Exception originalCause) {
        super(message, originalCause);
    }
}
