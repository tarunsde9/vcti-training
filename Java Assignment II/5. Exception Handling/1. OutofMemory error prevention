import java.util.ArrayList;
import java.util.List;

// Memory Leak - Memory leak is when an object is no longer needed but the program
//               still contains reference to the object.
//               Garbage collector cannot collect those objects.
// Design Issue - Application design unnecessarily consumes large amount of memory.
//                Memory usage is excessive due to inefficient deign.
// OutOfMemoryError is caused by both memory leak and design issue.

public class Q1 {
    public static void main(String[] args) {
        List<int[]> list = new ArrayList<>();
        for(int i=0; i<100; i++) {
            list.add(new int[1000000]);
            if(i%5==0) list.clear();
        }
        System.out.println("Completed without OutOfMemoryError");
    }
}
