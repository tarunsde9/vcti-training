// LinkedList reversal logic:

void reverse() {
    if(head == null)
        return;

    Node prev = null;
    last = head;
    Node temp = head;
    while(temp != null) {
        Node curr = temp;
        temp = temp.next;
        curr.next = prev;
        prev = curr;
    }
    head = prev;
}

