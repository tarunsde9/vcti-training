BinarySearch.java
public class BinarySearch {
    public int search(int[] array, int target) {
        int low = 0;
        int high = array.length-1;

        while(low <= high) {
            int mid = low+(high-low)/2;

            if(array[mid] == target) {
                return mid;
            }
            if(target < array[mid]) {
                high = mid-1;
            } else {
                low = mid + 1;
            }
        }
        return -1;
    }
}

Main.java
class Main {
    public static void main(String[] args) {
        int[] arr = new int[]{1,4,5,6,7,10,11,42,55,95,124};
        BinarySearch bs = new BinarySearch();

        int index = bs.search(arr, 55);
        System.out.println(index);

    }
}
