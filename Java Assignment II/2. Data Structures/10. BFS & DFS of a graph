class Solution {
    public ArrayList<Integer> bfs(ArrayList<ArrayList<Integer>> adj) {
        // code here
        
        ArrayList<Integer> ans = new ArrayList<>();
        int n = adj.size();
        int[] vis = new int[n];
        Queue<Integer> q = new LinkedList<>();
        q.add(0);
        vis[0] = 1;
        
        while(!q.isEmpty()) {
            int num = q.poll();
            ans.add(num);
            for(int it: adj.get(num)) {
                if(vis[it] == 0)
                    q.add(it);
                vis[it] = 1;
            }
        }
        return ans;
    }
}

class Solution {
    public ArrayList<Integer> dfs(ArrayList<ArrayList<Integer>> adj) {
        // code here
        int n = adj.size();
        int[] vis = new int[n];
        ArrayList<Integer> ans = new ArrayList<>();
        solve(adj, vis, ans, 0);
        return ans;
    }
    
    private void solve(ArrayList<ArrayList<Integer>> adj, int[] vis, ArrayList<Integer> ans, int i) {
        
        vis[i] = 1;
        ans.add(i);
        for(int it: adj.get(i)) {
            if(vis[it] == 0)
                solve(adj, vis, ans, it);
        }  
    }
}
