package Q4;

import java.util.Arrays;
import java.util.List;

public class Main {
    public static void main(String[] args) {
        List<List<Integer>> numbers = Arrays.asList(
                Arrays.asList(1, 2, 3),
                Arrays.asList(3, 4, 5),
                Arrays.asList(5, 6, 7)
        );

        numbers.stream()
                .flatMap(list -> list.stream())
                .distinct()
                .forEach(n -> System.out.println(n));
    }
}
