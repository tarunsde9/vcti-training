package q5;

import java.util.concurrent.locks.ReentrantLock;
import java.lang.management.ManagementFactory;
import java.lang.management.ThreadMXBean;

public class DeadLockDemo {
    static ReentrantLock lockA = new ReentrantLock();
    static ReentrantLock lockB = new ReentrantLock();

    public static void main(String[] args) throws InterruptedException {
        Thread t1 = new Thread(() -> {
            try {
                lockA.lock();

                System.out.println("Thread 1 acquired Lock A");
                Thread.sleep(100);

                lockB.lockInterruptibly();

                try {
                    System.out.println("Thread 1 acquired Lock B");
                } finally {
                    lockB.unlock();
                }

            } catch (InterruptedException e) {
                System.out.println("Thread 1 interrupted!");

            } finally {
                if (lockA.isHeldByCurrentThread()) {
                    lockA.unlock();
                }
            }
        });

        Thread t2 = new Thread(() -> {
            try {
                lockB.lock();

                System.out.println("Thread 2 acquired Lock B");
                Thread.sleep(100);

                lockA.lockInterruptibly();

                try {
                    System.out.println("Thread 2 acquired Lock A");
                } finally {
                    lockA.unlock();
                }

            } catch (InterruptedException e) {
                System.out.println("Thread 2 interrupted!");

            } finally {
                if (lockB.isHeldByCurrentThread()) {
                    lockB.unlock();
                }
            }
        });

        t1.start();
        t2.start();

        Thread.sleep(500);

        detectAndResolveDeadlock(t1, t2);

        t1.join();
        t2.join();

        System.out.println("Program completed.");
    }

    static void detectDeadlock() {

        ThreadMXBean bean = ManagementFactory.getThreadMXBean();

        long[] ids = bean.findDeadlockedThreads();

        if (ids != null) {
            System.out.println("Deadlock detected!");

            for (long id : ids) {
                System.out.println("Deadlocked Thread ID: " + id);
            }
        } else {
            System.out.println("No deadlock detected.");
        }
    }

    static void detectAndResolveDeadlock(Thread t1, Thread t2) {

        ThreadMXBean bean =
                ManagementFactory.getThreadMXBean();

        long[] ids = bean.findDeadlockedThreads();

        if (ids != null) {
            System.out.println("Deadlock detected!");

            // Interrupt Thread 1 to resolve the deadlock
            t1.interrupt();

        } else {
            System.out.println("No deadlock detected.");
        }
    }
}
