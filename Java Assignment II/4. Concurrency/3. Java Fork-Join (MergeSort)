package q3;

import java.util.concurrent.*;

public class MergeSort {
    public static void main(String[] args) {
        int[] arr = {8, 3, 6, 2, 7, 1, 5, 4};

        ForkJoinPool pool = new ForkJoinPool();

        pool.invoke(new MergeSortTask(arr, 0, arr.length - 1));

        pool.shutdown();

        System.out.println("Sorted Array:");
        for (int num : arr) {
            System.out.print(num + " ");
        }
    }
}

class MergeSortTask extends RecursiveAction {
    int[] arr;
    int left, right;

    public MergeSortTask(int[] arr, int left, int right) {
        this.arr = arr;
        this.left = left;
        this.right = right;
    }

    @Override
    protected void compute() {
        if(left < right) {
            int mid = (left+right)/2;
            MergeSortTask left = new MergeSortTask(arr, this.left, mid);
            MergeSortTask right = new MergeSortTask(arr, mid+1, this.right);

            left.fork();
            right.compute();
            
            left.join();
            merge(this.left, mid, this.right, arr);
        }
    }

    public void merge(int left, int mid, int right, int[] arr) {
        int i=left, j=mid+1;
        int index=0;
        int[] temp = new int[right-left+1];
        while(i<=mid && j<=right) {
            if(arr[i] < arr[j]) {
                temp[index++] = arr[i++];
            } else {
                temp[index++] = arr[j++];
            }
        }
        while(i<=mid) {
            temp[index++] = arr[i++];
        }
        while(j<=right) {
            temp[index++] = arr[j++];
        }
        for(i=0; i<temp.length; i++) {
            arr[i+left] = temp[i];
        }
    }
}

