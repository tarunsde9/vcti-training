public class CustomArrayList {
    int[] array = new int[15];
    int last = -1;

    void add(int val) {
        array[++last] = val;
    }

    void add(int index, int value) {
        for(int i=last+1; i>index; i--) {
            array[i] = array[i - 1];
        }
        array[index] = value;
    }

    int indexOf(int val) {
        if(isEmpty()) {
            return -1;
        }

        int index = -1;
        for(int i=0; i<=last; i++) {
            if(array[i] == val) {
                index = i;
                break;
            }
        }
        return index;
    }

    boolean contains(int val) {
        if(isEmpty()) {
            return false;
        }
        boolean index = false;
        for(int i=0; i<=last; i++) {
            if(array[i] == val) {
                index = true;
                break;
            }
        }
        return index;
    }

    int addAll() {
        int sum = 0;
        for(int i: array) {
            sum += i;
        }
        return sum;
    }

    boolean isEmpty() {
        return (last == -1);
    }
}
