package q6;

import java.util.concurrent.Semaphore;

public class Main {
    static Semaphore semaphore = new Semaphore(3);
    public static void main(String[] args) {
        for(int i=1; i<=10; i++) {
            Thread t = new Thread(new DatabaseTask(), "Thread-"+i);
            t.start();
        }
    }
}

class DatabaseTask implements Runnable {
    @Override
    public void run() {
        try {
            System.out.println(Thread.currentThread().getName() + " waiting for connection");

            Main.semaphore.acquire();

            Thread.sleep(2000);

            System.out.println(Thread.currentThread().getName() + " finished database operation");

        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        } finally {
            if(!Thread.currentThread().isInterrupted()) {
                Main.semaphore.release();
            }
        }
    }
}
